<Window x:Class="HttpMonitorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="HTTP Monitor" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель с элементами управления -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Панель сервера -->
            <GroupBox Grid.Column="0" Header="HTTP Сервер" Margin="5">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                        <Label Content="Порт:" VerticalAlignment="Center"/>
                        <TextBox x:Name="PortTextBox" Text="8080" Width="60" Margin="5,0"/>
                        <Button x:Name="StartServerButton" Content="Запустить" Width="75" 
                                Click="StartServerButton_Click" Margin="5,0"/>
                        <Button x:Name="StopServerButton" Content="Остановить" Width="75" 
                                Click="StopServerButton_Click" IsEnabled="False" Margin="5,0"/>
                    </StackPanel>

                    <Label Grid.Row="1" x:Name="ServerStatusLabel" Content="Сервер не запущен" 
                           Foreground="Gray"/>
                </Grid>
            </GroupBox>

            <!-- Панель клиента -->
            <GroupBox Grid.Column="1" Header="HTTP Клиент" Margin="5">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                        <Label Content="URL:" VerticalAlignment="Center"/>
                        <TextBox x:Name="UrlTextBox" Width="200" Margin="5,0"
                                 Text="http://localhost:8080/"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,5">
                        <Label Content="Метод:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="MethodComboBox" Width="70" Margin="5,0"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="GET"/>
                            <ComboBoxItem Content="POST"/>
                        </ComboBox>
                        <Button x:Name="SendRequestButton" Content="Отправить" Width="75"
                                Click="SendRequestButton_Click" Margin="5,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <Label Content="Тело запроса (JSON для POST):"/>
                        <TextBox x:Name="RequestBodyTextBox" Height="60" 
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 Text="{}{&quot;message&quot;: &quot;Тестовое сообщение&quot;}"
                                 IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Основная область с вкладками -->
        <TabControl Grid.Row="1" Margin="5">
            <!-- Вкладка логов -->
            <TabItem Header="Логи">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                        <Label Content="Фильтр:"/>
                        <ComboBox x:Name="LogFilterComboBox" Width="100" Margin="5,0"
                                  SelectionChanged="LogFilterComboBox_SelectionChanged">
                            <ComboBoxItem Content="Все"/>
                            <ComboBoxItem Content="GET"/>
                            <ComboBoxItem Content="POST"/>
                        </ComboBox>
                        <Label Content="Статус:" Margin="10,0,0,0"/>
                        <ComboBox x:Name="StatusFilterComboBox" Width="100" Margin="5,0"
                                  SelectionChanged="StatusFilterComboBox_SelectionChanged">
                            <ComboBoxItem Content="Все"/>
                            <ComboBoxItem Content="200 OK"/>
                            <ComboBoxItem Content="201 Created"/>
                            <ComboBoxItem Content="400 Bad Request"/>
                            <ComboBoxItem Content="500 Error"/>
                        </ComboBox>
                    </StackPanel>

                    <ListBox Grid.Row="1" x:Name="LogsListBox" 
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>

            <!-- Вкладка статистики -->
            <TabItem Header="Статистика">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock x:Name="StatsTextBlock" FontFamily="Consolas" 
                                   FontSize="14" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="200"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Content="График нагрузки (запросы в минуту)" 
                               FontWeight="Bold"/>

                        <DataGrid Grid.Row="1" x:Name="RequestsDataGrid" 
                                  AutoGenerateColumns="False" Margin="0,5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Время" Binding="{Binding Time}" Width="150"/>
                                <DataGridTextColumn Header="GET" Binding="{Binding GetCount}" Width="100"/>
                                <DataGridTextColumn Header="POST" Binding="{Binding PostCount}" Width="100"/>
                                <DataGridTextColumn Header="Всего" Binding="{Binding TotalCount}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Row="2" Margin="0,5">
                            <oxy:PlotView x:Name="LoadPlot" />
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Вкладка ответа клиента -->
            <TabItem Header="Ответ клиента">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                        <Label Content="Время ответа:"/>
                        <Label x:Name="ResponseTimeLabel" Content="0 ms" Margin="5,0"/>
                        <Label Content="Статус:" Margin="10,0,0,0"/>
                        <Label x:Name="ResponseStatusLabel" Content="-" Margin="5,0"/>
                    </StackPanel>

                    <TextBox Grid.Row="1" x:Name="ResponseTextBox" 
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" 
                             IsReadOnly="True" FontFamily="Consolas"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
